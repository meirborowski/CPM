// CPM builds itself with CPM. Fresh clone: run scripts/bootstrap.ps1 (or scripts/bootstrap.sh)
// once, then use `cpm build`, `cpm test`. See docs/spec/architecture.md §7.
{
  "$schema": "./schema/cpm.schema.json",
  "name": "cpm",
  "version": "0.4.9",
  "description": "C++ package manager and build system",
  "license": "MIT",
  "std": "c++23",
  "type": "executable",

  "scripts": {
    "selfhost": "pwsh -NoProfile -File scripts/selfhost.ps1"
  },

  // CPM itself has no runtime dependencies, so the bootstrap stays a single compiler call.
  "devDependencies": {
    // The test framework behind tests/support/check.hpp: cpm-org's cpm-test, from the default registry.
    "cpm-test": "^0.1.0"
  },

  "profiles": {
    // Release binaries are distributed, so link the C++ runtime statically.
    "release": { "opt": 2, "runtime": "static" },
    // The Linux release binary: fully static, built against musl in Alpine (.github/workflows/release.yml).
    // Static glibc binaries are not portable, so this profile is only meant for that build.
    "dist": { "inherits": "release", "ldflags": ["-static"] }
  },

  "platforms": {
    "windows": { "systemLibs": ["shell32"] },
    "unix": { "systemLibs": ["pthread"] }
  }
}
